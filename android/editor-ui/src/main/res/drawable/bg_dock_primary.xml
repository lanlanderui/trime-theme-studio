<!--
  B2 dock：主色底（稿子 inline style 覆盖了 .b-dock 的 pcontainer，用的就是
  主色那一档）。

  与 B1 的 bg_dock（主色容器底）不是同一张：B2 的 dock 要更重——它管的是
  方案的增删改，不是页面导航。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/ui_primary" />
    <corners android:radius="?attr/ui_radius_button" />
</shape>
