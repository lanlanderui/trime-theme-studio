<!--
  可直接改的单值行：左边中文名 + 键名，右边一个等宽输入框，下面一条很淡的下划线。

  候选窗那页是「就地改数值」而不是「点开对话框」——两种交互都要留着，
  但外观必须是同一套：一张卡片里的一行，不能因为可编辑就长成输入表单。
  下划线是唯一的「这里能输入」的提示，不画框、不加底色。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="3dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="3dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="9dp"
        android:paddingEnd="16dp"
        android:paddingBottom="9dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/proofName"
                style="@style/Ui.Name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true" />

            <TextView
                android:id="@+id/proofKey"
                style="@style/Ui.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ui_row_gap"
            android:gravity="end"
            android:orientation="vertical">

            <EditText
                android:id="@+id/proofField"
                android:layout_width="wrap_content"
                android:minWidth="72dp"
                android:layout_height="wrap_content"
                android:background="@null"
                android:fontFamily="monospace"
                android:gravity="end"
                android:imeOptions="actionDone"
                android:inputType="numberDecimal"
                android:maxLines="1"
                android:minHeight="0dp"
                android:paddingStart="0dp"
                android:paddingTop="0dp"
                android:paddingEnd="0dp"
                android:paddingBottom="3dp"
                android:selectAllOnFocus="true"
                android:textColor="?attr/ui_ink"
                android:textSize="11.5sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/ui_rule_strong" />

            <TextView
                android:id="@+id/proofAction"
                style="@style/Ui.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="?attr/ui_accent"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
