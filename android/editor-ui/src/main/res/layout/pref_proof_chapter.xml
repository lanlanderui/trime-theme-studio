<!--
  章节头：主色小字 + 右侧「11 项 / 已改 2」。

  原来是「一条比纸略亮的色带 + 下缘重线」，靠色带说明「这一段到哪结束」。
  卡片化之后这个活交给间距了：组名 20dp 上距、6dp 下距，下面一叠卡片自己
  会围成一个组；再加色带就是第二条分隔线，跟卡片的描边打架。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/proofChapterTitle"
            style="@style/Ui.SectionLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true" />

        <TextView
            android:id="@+id/proofChapterExtra"
            style="@style/Ui.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ui_row_gap"
            android:singleLine="true" />
    </LinearLayout>
</LinearLayout>
