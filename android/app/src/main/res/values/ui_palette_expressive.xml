    <color name="expressive_stale_fill">#FFFFF0D6</color>
    <color name="expressive_stale_text">#FF6A3B00</color>
    <color name="expressive_chip_text">#FF55433B</color>
    <color name="expressive_chip_text_selected">#FFFFFFFF</color>
